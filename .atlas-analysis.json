  "keyFeatures": [
    "Multi-tenant loan origination platform for DSAs and financial institutions",
    "End-to-end KYC verification (Aadhaar, PAN, Driving License, Passport)",
    "Automated CIBIL score retrieval and AI-powered report parsing",
    "Bank statement upload and analysis via Account Aggregator (Setu) and Perfios",
    "GST return and ITR (salaried & business) data retrieval",
    "Loan eligibility calculation with Vanilla Report scoring engine",
    "Role-based access control with granular permissions",
    "Karza webhook integration for real-time event processing",
    "Co-applicant support on loan applications",
    "Encrypted PII storage with masked data accessors"
  ],
